        "stale": {
          "file": "queue-stall-review.md",
          "file_time_set_by_harness": "2026-09-20T16:20:00+00:00",
          "document_time_memforge_saw": "2026-09-20T16:20:00+00:00",
          "memories": [
            {
              "id": "mem-fb999b040c831555",
              "type": "procedure",
              "status": "active",
              "content": "The queue database’s fsync was restored, and a startup check was added that refuses to run with fsync off. The on-call engineer is paged when no job has started for five minutes."
            },
            {
              "id": "mem-def971511defef85",
              "type": "fact",
              "status": "active",
              "content": "In the Kestrel queue incident, a configuration change turned fsync off on the queue database. A crash then left the WAL file corrupt, and every worker waited on a lock that was never released."
            }
          ]
        },
        "current": {
          "file": "stall-postmortem.md",
          "file_time_set_by_harness": "2026-10-14T10:00:00+00:00",
          "document_time_memforge_saw": "2026-10-14T10:00:00+00:00",
          "memories": [
            {
              "id": "mem-14c82a23b103bca7",
              "type": "decision",
              "status": "active",
              "content": "The fix was to restore fsync and add a startup check that refuses to run with fsync off."
            },
            {
              "id": "mem-ec425bba3816f1bf",
              "type": "fact",
              "status": "active",
              "content": "A configuration change that turned fsync off on the queue database caused a crash to leave the WAL file corrupt, after which every worker waited on a lock that was never released."
            }
          ]
        },
