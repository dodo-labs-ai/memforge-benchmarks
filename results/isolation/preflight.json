          "file_time_set_by_harness": "2026-07-08T09:30:00+00:00",
          "document_time_memforge_saw": "2026-07-08T09:30:00+00:00",
          "memories": [
            {
              "id": "mem-4deefaf23625ad4e",
              "type": "decision",
              "status": "active",
              "content": "Kestrel uses a short, fixed retry schedule instead of exponential backoff so that an operator can tell from the clock alone when a job will run again."
            },
            {
              "id": "mem-34ba6e6ce720ce28",
              "type": "fact",
              "status": "active",
              "content": "After its last retry fails, the job moves to the kestrel-dlq queue, where it stays until an operator requeues or deletes it."
            },
            {
              "id": "mem-3f28f39ee0d17ef0",
              "type": "procedure",
              "status": "active",
              "content": "A Kestrel job that raises an error is retried three times, waiting 10, 60 and 300 seconds between attempts."
            }
          ]
        },
        "current": {
          "file": "job-retry-policy.md",
          "file_time_set_by_harness": "2026-10-02T14:10:00+00:00",
          "document_time_memforge_saw": "2026-10-02T14:10:00+00:00",
          "memories": [
            {
              "id": "mem-3de3674ef8eeaeda",
              "type": "procedure",
              "status": "active",
              "content": "A Kestrel job that raises an error is retried five times, with waits of 10, 60, 300, 900 and 3600 seconds between attempts. After the last retry fails, the job moves to the kestrel-dlq queue and remains there until an operator requeues it with `kestrel-admin requeue` or deletes it."
            }
          ]
        },
